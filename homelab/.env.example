# ── Configuración global del homelab de la agencia ─────────────────────────────
# ./hl env copia este archivo a .env la primera vez. Edita los valores y vuelve a
# ejecutar ./hl env para generar los .env de cada stack con estos datos.

# Dominio principal. Cada servicio vive en un subdominio: n8n.agencia.com, crm.agencia.com, ...
DOMINIO=agencia.com

# Dominio del correo del equipo. Vaultwarden solo dejará registrarse a correos de este dominio.
DOMINIO_CORREO=agencia.com

# Zona horaria de los servidores (la academia está en Utah)
TZ=America/Denver

# Correo de la persona administradora (avisos de los servicios)
CORREO_ADMIN=admin@agencia.com

# Dónde deja las copias scripts/backup.sh (idealmente un NAS montado por NFS/SMB)
BACKUP_DIR=/mnt/nas/backups/homelab
# Días que se conservan las copias
BACKUP_KEEP_DAYS=14
