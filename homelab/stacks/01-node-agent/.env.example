# Token del túnel de Cloudflare de ESTE nodo (Zero Trust → Networks → Tunnels → Create → copiar token). Ver docs/cloudflare-tunnel.md
CLOUDFLARE_TUNNEL_TOKEN=
# Activa cloudflared en este nodo. En la Raspberry Pi déjalo vacío (COMPOSE_PROFILES=) para que solo corra el agente.
COMPOSE_PROFILES=tunnel
# Llave pública que muestra Beszel al hacer "Add system" (panel → http://IP-NODO1:8090)
BESZEL_AGENT_KEY=
