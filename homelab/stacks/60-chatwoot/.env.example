# Estas variables se pasan completas a Chatwoot (env_file). Referencia: https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables
SECRET_KEY_BASE=__GENERAR__
FRONTEND_URL=https://chat.__DOMINIO__
DEFAULT_LOCALE=es
FORCE_SSL=false
# Ponlo en true SOLO para crear tu cuenta la primera vez; luego false y ./hl up chatwoot
ENABLE_ACCOUNT_SIGNUP=true
INSTALLATION_ENV=docker
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
RAILS_MAX_THREADS=5
ACTIVE_STORAGE_SERVICE=local

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=__GENERAR__
POSTGRES_DATABASE=chatwoot
REDIS_PASSWORD=__GENERAR__

# Correo saliente (invitaciones, notificaciones). Rellena con tu proveedor SMTP (Brevo, Resend, Gmail con clave de app…)
MAILER_SENDER_EMAIL=Chatwoot <chat@__DOMINIO__>
SMTP_DOMAIN=__DOMINIO__
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
